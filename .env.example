# =====================================================================
#  HAYBIKE SYSTEM - Environment Variables
#  Salin berkas ini menjadi `.env.local` lalu isi sesuai proyek Anda.
#  Semua variabel Vite WAJIB berawalan VITE_ agar terbaca di browser.
# =====================================================================

# --- Firebase ---
# Catatan: nilai-nilai ini BUKAN rahasia. Konfigurasi Firebase Web memang
# tampil di bundel browser. Pengamanan data Anda ada di firestore.rules
# dan Firebase Authentication, bukan pada penyembunyian nilai di bawah ini.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="haybike-apps.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="haybike-apps"
VITE_FIREBASE_STORAGE_BUCKET="haybike-apps.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="955945329468"
VITE_FIREBASE_APP_ID="1:955945329468:web:..."

# Domain internal untuk akun yang login memakai username tanpa email asli.
# Username "kasir_siti" akan menjadi "kasir_siti@haybike.local" di Firebase Auth.
VITE_INTERNAL_EMAIL_DOMAIN="haybike.local"
